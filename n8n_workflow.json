      "parameters": {
        "jsCode": "const data = $input.first().json;\nconst i = data.indeed     || { queued: 0, skipped: 0, duplicates: 0 };\nconst b = data.bayt       || { queued: 0, skipped: 0, duplicates: 0 };\nconst n = data.naukrigulf || { queued: 0, skipped: 0, duplicates: 0 };\n\nconst totalQueued     = i.queued     + b.queued     + n.queued;\nconst totalSkipped    = i.skipped    + b.skipped    + n.skipped;\nconst totalDuplicates = i.duplicates + b.duplicates + n.duplicates;\n\nconst now = new Date();\nconst uaeDate = new Date(now.getTime() + 4 * 60 * 60 * 1000);\nconst dateStr = uaeDate.toISOString().split('T')[0];\n\nconst msg = [\n  `🤖 *AI Job Hunter — ${dateStr}*`,\n  ``,\n  `📋 *Queued:*     ${totalQueued} CVs generated`,\n  `⏭ *Skipped:*    ${totalSkipped} (score too low)`,\n  `🔁 *Duplicates:* ${totalDuplicates} (already seen)`,\n  ``,\n  `📌 *By source:*`,\n  `  • Indeed:      ${i.queued}Q / ${i.skipped}S / ${i.duplicates}D`,\n  `  • Bayt:        ${b.queued}Q / ${b.skipped}S / ${b.duplicates}D`,\n  `  • Naukrigulf:  ${n.queued}Q / ${n.skipped}S / ${n.duplicates}D`,\n].join('\\n');\n\nreturn [{ json: { message: msg, date: dateStr, totalQueued, totalSkipped, totalDuplicates } }];"
      },
